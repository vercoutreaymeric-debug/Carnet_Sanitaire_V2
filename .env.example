# ============================================================
#  Carnet Sanitaire V2 — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Base de données ---
# Local :
DATABASE_URL="postgresql://USER:MOT_DE_PASSE@localhost:5432/carnet_sanitaire"

# Azure PostgreSQL Flexible Server :
# DATABASE_URL="postgresql://USER:MOT_DE_PASSE@NOM_SERVEUR.postgres.database.azure.com:5432/carnet_sanitaire?sslmode=require"

# Note : si le mot de passe contient * encodez en %2A  et / en %2F
# Exemple : cifec123456789*/ devient cifec123456789%2A%2F

# --- Authentification ---
AUTH_USERNAME="admin"
AUTH_PASSWORD="cifec2024"
AUTH_SECRET="cs-secret-key-cifec-2024"

# Changer AUTH_SECRET en production avec une valeur aleatoire longue

# --- Notifications email ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="votre.email@gmail.com"
SMTP_PASS="votre_mot_de_passe_application"
SMTP_FROM="Carnet Sanitaire <votre.email@gmail.com>"

# URL publique de l'app (pour les liens dans les emails)
APP_URL="https://votre-app.azurewebsites.net"

# Secret pour protéger l'endpoint cron (choisir une valeur aléatoire longue)
NOTIFY_SECRET="changer-ce-secret-aleatoire-long"
